<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description" content="Improve your book listing presentation with Amazon metadata support, keyword research and A+ Content design from Wise Media Freelance.">

    <title>Amazon Optimization & A+ Content | WMF</title>

    <link rel="stylesheet" href="assets/css/styles.css">

    <style>
        :root {
            --navy: #0B1020;
            --black: #080808;
            --gold: #D6B46A;
            --white: #FFFFFF;
            --gray: #A8A8A8;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--black);
            color: var(--white);
            font-family: Arial, sans-serif;
            line-height: 1.7;
        }

        a {
            text-decoration: none;
        }

        .gold-text {
            color: var(--gold);
        }

        .amazon-hero {
            min-height: 540px;
            padding: 100px 8%;
            display: flex;
            align-items: center;
            background:
                linear-gradient(
                    90deg,
                    rgba(8, 8, 8, .97),
                    rgba(11, 16, 32, .85)
                ),
                radial-gradient(
                    circle at 80% 40%,
                    #69522B,
                    #0B1020 60%
                );
        }

        .hero-content {
            max-width: 780px;
        }

        .eyebrow {
            color: var(--gold);
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 13px;
            font-weight: bold;
        }

        .amazon-hero h1 {
            font-size: clamp(36px, 6vw, 62px);
            line-height: 1.15;
            margin: 20px 0;
        }

        .amazon-hero p {
            color: #D0D0D0;
            font-size: 17px;
            max-width: 680px;
        }

        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-top: 30px;
        }

        .wmf-button {
            display: inline-block;
            padding: 14px 25px;
            background: var(--gold);
            color: var(--black);
            font-weight: bold;
            border: 1px solid var(--gold);
            cursor: pointer;
            transition: .3s;
        }

        .wmf-button:hover {
            background: transparent;
            color: var(--gold);
        }

        .wmf-button.outline {
            background: transparent;
            color: var(--gold);
        }

        .wmf-button.outline:hover {
            background: var(--gold);
            color: var(--black);
        }

        .section {
            padding: 80px 8%;
        }

        .section-heading {
            max-width: 760px;
            margin-bottom: 40px;
        }

        .section-heading h2 {
            font-size: clamp(28px, 4vw, 42px);
            margin: 10px 0;
        }

        .section-heading p {
            color: var(--gray);
        }

        .gold-line {
            width: 65px;
            height: 3px;
            background: var(--gold);
            margin: 15px 0;
        }

        .intro-section {
            background: var(--white);
            color: var(--black);
        }

        .intro-section p {
            color: #555;
            max-width: 900px;
        }

        .service-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .service-card {
            background: #111827;
            border: 1px solid #303746;
            border-radius: 8px;
            padding: 30px;
        }

        .service-card h3 {
            color: var(--gold);
            margin-top: 0;
        }

        .service-card p,
        .service-card li {
            color: #C5C5C5;
        }

        .service-card ul {
            padding-left: 20px;
        }

        .service-card li {
            margin-bottom: 10px;
        }

        .scope-section {
            background: #101626;
        }

        .scope-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
        }

        .scope-box {
            background: #080D18;
            padding: 30px;
            border: 1px solid #303746;
            border-radius: 8px;
        }

        .scope-box h3 {
            color: var(--gold);
        }

        .scope-box ul {
            color: #C5C5C5;
            padding-left: 20px;
        }

        .scope-box li {
            margin-bottom: 12px;
        }

        .package-section {
            background: var(--black);
        }

        .package-card {
            background: #111827;
            border: 1px solid #343B4B;
            border-radius: 8px;
            padding: 30px;
            display: flex;
            flex-direction: column;
        }

        .package-card.featured {
            border-color: var(--gold);
        }

        .package-card h3 {
            color: var(--gold);
            font-size: 23px;
        }

        .package-price {
            font-size: 24px;
            font-weight: bold;
            margin: 12px 0;
        }

        .package-card p,
        .package-card li {
            color: #C5C5C5;
        }

        .package-card ul {
            padding-left: 20px;
            flex: 1;
        }

        .package-card li {
            margin-bottom: 12px;
        }

        .package-note {
            color: var(--gray);
            font-size: 13px;
            margin-top: 25px;
        }

        .requirements-section {
            background: #101626;
        }

        .process-number {
            font-size: 34px;
            font-weight: bold;
            color: var(--gold);
        }

        .notice {
            background: #292317;
            border-left: 4px solid var(--gold);
            padding: 18px;
            color: #E8D9B6;
            margin-top: 25px;
            font-size: 14px;
        }

        .faq-section {
            background: var(--black);
        }

        .faq-item {
            border-bottom: 1px solid #343434;
            padding: 20px 0;
        }

        .faq-question {
            width: 100%;
            background: none;
            border: none;
            color: var(--white);
            text-align: left;
            font-size: 17px;
            font-weight: bold;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            gap: 20px;
        }

        .faq-question span {
            color: var(--gold);
            font-size: 22px;
        }

        .faq-answer {
            display: none;
            color: #BDBDBD;
            padding-top: 12px;
        }

        .faq-item.open .faq-answer {
            display: block;
        }

        .final-cta {
            text-align: center;
            padding: 90px 8%;
            background: linear-gradient(120deg, #101626, #252013);
        }

        .final-cta h2 {
            font-size: clamp(28px, 4vw, 42px);
        }

        .final-cta p {
            color: #D0D0D0;
            max-width: 680px;
            margin: 15px auto 30px;
        }

        @media (max-width: 900px) {
            .service-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 650px) {
            .amazon-hero {
                padding: 75px 6%;
            }

            .section {
                padding: 60px 6%;
            }

            .service-grid,
            .scope-grid {
                grid-template-columns: 1fr;
            }

            .hero-buttons {
                flex-direction: column;
            }

            .wmf-button {
                width: 100%;
                text-align: center;
            }
        }
    </style>
</head>

